[Unit]
Description=Lunaris proxy node and management API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=true
StateDirectory=lunaris
StateDirectoryMode=0700
WorkingDirectory=/var/lib/lunaris
ExecStart=/usr/local/bin/lunaris-web serve --config /etc/lunaris/bootstrap.yaml
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
